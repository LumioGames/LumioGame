index 0000000..5baca4d
--- /dev/null
+++ "b/games\\101-bomber\\Client\\Presentation\\src\\present\\touch-controls.ts"
@@ -0,0 +1,231 @@
+import { 方向, type SkillId } from '../contract'
+import type { SkillButtonView } from '../present/skill-hud'
+import { SKILL_ICON, skillCss } from '../present/skill-style'
+import { Joystick4 } from './joystick'
+import './touch.css'
+
+export interface TouchActions {
+  move(primary: 方向, secondary: 方向): void
+  bomb(): void
+  skill(): void
+  ready(): boolean
+}
+
+/** 摇杆可起手的区域：屏幕左侧 45%（右侧留给放弹按钮与 HUD）。 */
+const STICK_ZONE = 0.45
+
+/** 点在 HUD 可交互元素上时不起摇杆（按钮、滑条、结算 / 暂停遮罩都标了 data-ui）。 */
+function isUiTarget(t: EventTarget | null): boolean {
+  const e = t as Element | null
+  return typeof e?.closest === 'function' && e.closest('button, input, select, a, [data-ui]') !== null
+}
+
+/**
+ * 触屏控件：左下浮动虚拟摇杆（底座 120 px、摇杆头 52 px）+ 右下 88 px 放弹按钮（参考图同款圆按钮）
+ * + 放弹按钮左边 68 px 技能「副按钮」（原型扩展 NON-CONTRACT，ADR 0030：主动槽技能，带冷却环；主动槽为空时隐藏）。
+ * 只在触屏设备显示（`(pointer: coarse)` 或第一次触摸之后）。
+ */
+export class TouchControls {
+  private readonly stick = new Joystick4(60, 0.18, 0.15)
+  private readonly base: HTMLDivElement
+  private readonly knob: HTMLDivElement
+  private readonly bomb: HTMLButtonElement
+  private readonly skill: HTMLButtonElement
+  private readonly skillIco: HTMLSpanElement
+  private readonly skillSec: HTMLSpanElement
+  private readonly skillLabel: HTMLSpanElement
+  private skillShown: SkillId | null = null
+  private pointerId: number | null = null
+  private visible = false
+  private enabled = false
+  private skillReady = false
+  private sentDirection: 方向 = 方向.停
+  private sentSecondary: 方向 = 方向.停
+  private readonly off: (() => void)[] = []
+
+  constructor(
+    private readonly root: HTMLElement,
+    private readonly actions: TouchActions,
+    private readonly target: Window,
+  ) {
+    root.classList.add('touch-root')
+    this.base = document.createElement('div')
+    this.base.className = 'tc-stick is-idle'
+    this.knob = document.createElement('div')
+    this.knob.className = 'tc-knob'
+    this.base.appendChild(this.knob)
+    this.bomb = document.createElement('button')
+    this.bomb.type = 'button'
+    this.bomb.className = 'tc-bomb'
+    this.bomb.setAttribute('aria-label', '放炸弹')
+    this.bomb.innerHTML =
+      '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="14" r="7" fill="currentColor"/>' +
+      '<rect x="8.7" y="5.4" width="3.6" height="2.6" rx=".6" fill="currentColor"/>' +
+      '<path d="M12 6c1-2.2 3.2-3 5-2.2" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>' +
+      '<circle cx="18.6" cy="3.6" r="1.8" fill="#FF7A3D"/></svg><span class="tc-bomb-label">放炸弹</span><span class="tc-bomb-key">SPACE</span>'
+    this.skill = document.createElement('button')
+    this.skill.type = 'button'
+    this.skill.className = 'tc-skill is-hidden'
+    this.skill.setAttribute('aria-label', '放技能')
+    this.skillIco = document.createElement('span')
+    this.skillIco.className = 'tc-skill-ico'
+    const cd = document.createElement('span')
+    cd.className = 'tc-skill-cd'
+    this.skillSec = document.createElement('span')
+    this.skillSec.className = 'tc-skill-sec'
+    this.skillLabel = document.createElement('span')
+    this.skillLabel.className = 'tc-skill-label'
+    this.skill.append(this.skillIco, cd, this.skillSec, this.skillLabel)
+    root.appendChild(this.base)
+    root.appendChild(this.bomb)
+    root.appendChild(this.skill)
+
+    this.listen(this.skill, 'pointerdown', (e) => {
+      e.preventDefault()
+      if (!this.enabled || !this.actions.ready() || !this.skillReady) return
+      this.actions.skill()
+      this.skill.classList.add('is-pressed')
+    })
+    for (const t of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
+      this.listen(this.skill, t, () => this.skill.classList.remove('is-pressed'))
+    }
+
+    this.listen(this.bomb, 'pointerdown', (e) => {
+      e.preventDefault()
+      if (!this.enabled || !this.actions.ready()) return
+      this.actions.bomb()
+      this.bomb.classList.add('is-pressed')
+    })
+    for (const t of ['pointerup', 'pointercancel', 'pointerleave'] as const) {
+      this.listen(this.bomb, t, () => this.bomb.classList.remove('is-pressed'))
+    }
+    this.listen(target, 'pointerdown', (e) => this.onDown(e as PointerEvent))
+    this.listen(target, 'pointermove', (e) => this.onMove(e as PointerEvent))
+    this.listen(target, 'pointerup', (e) => this.onUp(e as PointerEvent))
+    this.listen(target, 'pointercancel', (e) => this.onUp(e as PointerEvent))
+    this.listen(target, 'blur', () => this.release())
+    this.listen(target.document, 'visibilitychange', () => { if (target.document.hidden) this.release() })
+    this.listen(target, 'resize', () => this.release())
+    this.setEnabled(false)
+  }
+
+  show(): void {
+    if (this.visible) return
+    this.visible = true
+    this.root.classList.add('is-touch')
+  }
+
+  isVisible(): boolean {
+    return this.visible
+  }
+
+  setEnabled(enabled: boolean): void {
+    this.enabled = enabled
+    this.root.classList.toggle('is-blocked', !enabled)
+    this.bomb.disabled = !enabled
+    this.skill.disabled = !enabled || !this.skillReady
+    if (!enabled) this.release()
+  }
+
+  direction(): 方向 {
+    return this.stick.isActive() ? this.stick.direction() : 方向.停
+  }
+
+  /** 摇杆的副方向（原型扩展 NON-CONTRACT，ADR 0032）：次轴够大时是另一个「按住的方向」。 */
+  secondary(): 方向 {
+    return this.stick.isActive() ? this.stick.secondary() : 方向.停
+  }
+
+  /** 技能按钮的显示状态（每帧由 app 从 HUD 取来）；null = 主动槽为空，隐藏按钮。 */
+  setSkill(v: SkillButtonView | null): void {
+    const b = this.skill
+    this.skillReady = Boolean(v?.ready && !v.disabled)
+    b.disabled = !this.enabled || !this.skillReady
+    b.classList.toggle('is-hidden', v === null)
+    if (!v) {
+      this.skillShown = null
+      return
+    }
+    if (this.skillShown !== v.skill) {
+      this.skillShown = v.skill
+      this.skillIco.innerHTML = SKILL_ICON[v.skill]
+      b.style.setProperty('--skill', skillCss(v.skill))
+      b.setAttribute('aria-label', `放技能：${v.label}`)
+    }
+    const cd = (Math.round(v.cdFrac * 100) / 100).toFixed(2)
+    if (b.style.getPropertyValue('--cd') !== cd) b.style.setProperty('--cd', cd)
+    const sec = v.cdFrac > 0 ? String(Math.ceil(v.cdSec - 1e-6)) : ''
+    if (this.skillSec.textContent !== sec) this.skillSec.textContent = sec
+    if (this.skillLabel.textContent !== v.label) this.skillLabel.textContent = v.label
+    b.classList.toggle('is-ready', v.ready)
+    b.classList.toggle('is-effect', v.effect)
+    b.classList.toggle('is-disabled', v.disabled)
+  }
+
+  dispose(): void {
+    this.release()
+    for (const f of this.off) f()
+    this.off.length = 0
+    this.base.remove()
+    this.bomb.remove()
+    this.skill.remove()
+    this.root.classList.remove('touch-root', 'is-touch', 'is-blocked')
+  }
+
+  private listen(t: EventTarget, type: string, fn: (e: Event) => void): void {
+    t.addEventListener(type, fn)
+    this.off.push(() => t.removeEventListener(type, fn))
+  }
+
+  private onDown(e: PointerEvent): void {
+    if (e.pointerType === 'touch') this.show()
+    if (!this.visible || !this.enabled || !this.actions.ready() || this.pointerId !== null) return
+    if (e.clientX > this.target.innerWidth * STICK_ZONE || isUiTarget(e.target)) return
+    e.preventDefault()
+    this.pointerId = e.pointerId
+    this.stick.start(e.clientX, e.clientY)
+    this.base.classList.remove('is-idle')
+    this.base.style.left = `${e.clientX}px`
+    this.base.style.top = `${e.clientY}px`
+    this.drawKnob()
+  }
+
+  private onMove(e: PointerEvent): void {
+    if (e.pointerId !== this.pointerId) return
+    if (!this.actions.ready()) { this.release(); return }
+    e.preventDefault()
+    this.stick.move(e.clientX, e.clientY)
+    this.drawKnob()
+    this.emitDirection()
+  }
+
+  private onUp(e: PointerEvent): void {
+    if (e.pointerId === this.pointerId) this.release()
+  }
+
+  private release(): void {
+    this.pointerId = null
+    this.stick.end()
+    this.base.classList.add('is-idle')
+    this.base.style.left = ''
+    this.base.style.top = ''
+    this.drawKnob()
+    this.bomb.classList.remove('is-pressed')
+    this.skill.classList.remove('is-pressed')
+    this.emitDirection()
+  }
+
+  private emitDirection(): void {
+    const primary = this.direction()
+    const secondary = this.secondary()
+    if (primary === this.sentDirection && secondary === this.sentSecondary) return
+    this.sentDirection = primary
+    this.sentSecondary = secondary
+    this.actions.move(primary, secondary)
+  }
+
+  private drawKnob(): void {
+    this.knob.style.transform = `translate(${this.stick.knobX.toFixed(1)}px, ${this.stick.knobY.toFixed(1)}px)`
+    this.base.dataset.dir = String(this.stick.direction())
+  }
+}
diff --git "a/games\\101-bomber\\Client\\Presentation\\src\\present\\touch.css" "b/games\\101-bomber\\Client\\Presentation\\src\\present\\touch.css"
new file mode 100644
index 0000000..acadd4a
--- /dev/null
+++ "b/games\\101-bomber\\Client\\Presentation\\src\\present\\touch.css"
@@ -0,0 +1,184 @@
+/* 触屏控件：默认隐藏，只在 .is-touch 时显示（粗指针设备或第一次触摸之后）。 */
+.touch-root { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
+.touch-root.is-blocked { visibility: hidden; }
+.tc-bomb:disabled, .tc-skill:disabled { cursor: default; }
+/* Keep the approved sizes; tighten only the margins on 320px portrait screens. */
+@media (max-width: 350px) and (orientation: portrait) {
+  .touch-root .tc-stick.is-idle { left: calc(64px + env(safe-area-inset-left, 0px)); }
+  .touch-root .tc-skill { right: calc(114px + env(safe-area-inset-right, 0px)); }
+  .touch-root .tc-bomb { right: calc(16px + env(safe-area-inset-right, 0px)); }
+}
+.touch-root .tc-stick,
+.touch-root .tc-bomb {
+  display: none;
+}
+.touch-root.is-touch .tc-stick,
+.touch-root.is-touch .tc-bomb {
+  display: block;
+}
+
+.tc-stick {
+  position: absolute;
+  width: 120px;
+  height: 120px;
+  margin: -60px 0 0 -60px;
+  border-radius: 50%;
+  background: radial-gradient(circle, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0.14) 70%);
+  border: 2px solid rgba(255, 255, 255, 0.55);
+  box-shadow: 0 6px 18px rgba(43, 35, 32, 0.18);
+  -webkit-backdrop-filter: blur(6px);
+  backdrop-filter: blur(6px);
+  pointer-events: none;
+}
+.tc-stick.is-idle {
+  left: calc(92px + env(safe-area-inset-left, 0px));
+  top: calc(100% - 92px - env(safe-area-inset-bottom, 0px));
+  opacity: 0.6;
+}
+.tc-stick::before {
+  content: '';
+  position: absolute;
+  inset: 10px;
+  border-radius: 50%;
+  border: 2px dashed rgba(255, 255, 255, 0.25);
+}
+.tc-knob {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  width: 52px;
+  height: 52px;
+  margin: -26px 0 0 -26px;
+  border-radius: 50%;
+  background: rgba(255, 248, 236, 0.92);
+  border: 2px solid rgba(61, 184, 218, 0.9);
+  box-shadow: 0 4px 10px rgba(43, 35, 32, 0.25);
+}
+.tc-stick:not([data-dir='0']):not(.is-idle) .tc-knob {
+  background: #3db8da;
+  border-color: #fff8ec;
+}
+
+.tc-bomb {
+  position: absolute;
+  right: calc(24px + env(safe-area-inset-right, 0px));
+  bottom: calc(24px + env(safe-area-inset-bottom, 0px));
+  width: 88px;
+  height: 88px;
+  padding: 0;
+  border-radius: 50%;
+  border: 3px solid rgba(255, 255, 255, 0.75);
+  background: radial-gradient(circle at 35% 30%, #ffe08a 0%, #ffc93c 55%, #f0a92a 100%);
+  box-shadow: 0 8px 20px rgba(43, 35, 32, 0.28), inset 0 -4px 0 rgba(43, 35, 32, 0.12);
+  color: #2b2320;
+  font-family: ui-rounded, 'SF Pro Rounded', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
+  pointer-events: auto;
+  touch-action: none;
+  -webkit-tap-highlight-color: transparent;
+  transition: transform 0.08s;
+}
+.tc-bomb svg {
+  display: block;
+  width: 34px;
+  height: 34px;
+  margin: 12px auto 0;
+}
+.tc-bomb-label {
+  display: block;
+  font-size: 13px;
+  font-weight: 900;
+  line-height: 1.1;
+}
+.tc-bomb-key {
+  display: block;
+  font-size: 8px;
+  font-weight: 800;
+  letter-spacing: 0.12em;
+  opacity: 0.6;
+}
+.tc-bomb.is-pressed {
+  transform: scale(0.9);
+}
+
+/* 技能「副按钮」（ADR 0030）：放弹按钮左边，同一视觉家族；冷却用 conic 遮罩。 */
+.touch-root .tc-skill {
+  display: none;
+}
+.touch-root.is-touch .tc-skill {
+  display: block;
+}
+.touch-root.is-touch .tc-skill.is-hidden {
+  display: none;
+}
+.tc-skill {
+  --skill: #fff8ec;
+  --cd: 0;
+  position: absolute;
+  right: calc(24px + 88px + 18px + env(safe-area-inset-right, 0px));
+  bottom: calc(30px + env(safe-area-inset-bottom, 0px));
+  width: 68px;
+  height: 68px;
+  padding: 0;
+  border-radius: 50%;
+  border: 3px solid var(--skill);
+  background: radial-gradient(circle at 35% 30%, #4a3d37 0%, #2b2320 100%);
+  box-shadow: 0 8px 20px rgba(43, 35, 32, 0.28);
+  color: var(--skill);
+  font-family: ui-rounded, 'SF Pro Rounded', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
+  pointer-events: auto;
+  touch-action: none;
+  -webkit-tap-highlight-color: transparent;
+  transition: transform 0.08s;
+  overflow: hidden;
+}
+.tc-skill-ico svg {
+  display: block;
+  width: 30px;
+  height: 30px;
+  margin: 10px auto 0;
+}
+.tc-skill-cd {
+  position: absolute;
+  inset: 0;
+  border-radius: 50%;
+  background: conic-gradient(rgba(20, 16, 14, 0.72) calc(var(--cd) * 1turn), transparent 0);
+  pointer-events: none;
+}
+.tc-skill-sec {
+  position: absolute;
+  inset: 0;
+  display: grid;
+  place-items: center;
+  font-size: 22px;
+  font-weight: 900;
+  color: #fff;
+  pointer-events: none;
+}
+.tc-skill-label {
+  display: block;
+  font-size: 11px;
+  font-weight: 900;
+  color: #fff8ec;
+}
+.tc-skill.is-ready {
+  box-shadow: 0 0 0 3px var(--skill), 0 8px 20px rgba(43, 35, 32, 0.28);
+}
+.tc-skill.is-effect {
+  animation: tc-skill-pulse 0.6s ease-in-out infinite alternate;
+}
+.tc-skill.is-disabled {
+  opacity: 0.5;
+}
+.tc-skill.is-pressed {
+  transform: scale(0.9);
+}
+@keyframes tc-skill-pulse {
+  to {
+    box-shadow: 0 0 0 6px var(--skill), 0 8px 20px rgba(43, 35, 32, 0.28);
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .tc-skill.is-effect {
+    animation: none;
+  }
+}
