<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GameProductionProject>true</GameProductionProject>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>Lumio.Game.ServerGameplay</AssemblyName>
    <RootNamespace>Lumio.Game.ServerGameplay</RootNamespace>
    <!-- 本工程拥有自己的 ECS 声明（ADR-117）：注册表、实体模板与同步表由 Runtime 的 gen-declarations
         在构建时生成到 generated/server/，生成物入库、不手改。接线见仓根 Directory.Build.targets。 -->
    <LumioEcsGenerate>true</LumioEcsGenerate>
    <LumioEcsSide>server</LumioEcsSide>
    <!-- CA1051: Runtime 的 Sync<T> 字段协定要求公开可变字段，本工程的 ECS 组件遵循同一协定。 -->
    <NoWarn>$(NoWarn);CA1510;CA1051</NoWarn>
  </PropertyGroup>
  <Target Name="RequireLumioRuntimeRoot" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
    <Error
      Condition="'$(_LumioRuntimeRoot)' == '' or !Exists('$(LumioRuntimeEcsProject)')"
      Text="LUMIO_RUNTIME_MISSING: LumioGameRuntime was not found. Set LumioRuntimeRoot or LUMIO_RUNTIME_ROOT to a LumioGameRuntime checkout that contains modules/ecs/src/Lumio.GameRuntime.Ecs/Lumio.GameRuntime.Ecs.csproj; a sibling LumioGameRuntime is also searched. Do not hardcode machine-absolute paths." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(LumioRuntimeEcsProject)" />
    <ProjectReference Include="$(LumioRuntimeReplicationProject)" />
  </ItemGroup>
</Project>
