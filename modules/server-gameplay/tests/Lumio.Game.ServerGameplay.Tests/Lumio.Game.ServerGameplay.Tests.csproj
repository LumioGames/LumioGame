<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GameTestProject>true</GameTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);CA1861;CA1859;CA1707;xUnit2013;xUnit2029</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 只引用本仓工程与 Runtime 生产工程（LumioRuntimeRoot 见仓根 Directory.Build.targets）；
         不得引用引擎仓 tests/fixtures/samples（ADR-117，EngineTestAssetReferenceGuardTests 守）。 -->
    <ProjectReference Include="../../src/Lumio.Game.ServerGameplay/Lumio.Game.ServerGameplay.csproj" />
    <ProjectReference Include="$(LumioRuntimeReplicationProject)" />
    <ProjectReference Include="$(LumioRuntimeSimulationProject)" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="coverlet.MTP" />
  </ItemGroup>
</Project>
