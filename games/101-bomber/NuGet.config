<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="auditMode" value="all" />
    <add key="auditLevel" value="low" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- ADR-123: the engine SDK package ships in the Engine/ submodule (LumioEngineRelease). -->
    <add key="lumio-engine" value="Engine/sdk" />
  </packageSources>
  <!-- Lumio.Engine.SDK restores from Engine/sdk and nowhere else; third-party packages stay on nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="lumio-engine">
      <package pattern="Lumio.Engine.SDK" />
    </packageSource>
  </packageSourceMapping>
</configuration>
