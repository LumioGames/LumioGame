# This game's Platform inputs for the engine release compose (Engine/platform/docker-compose.yml,
# ADR-123 决策 8). The compose file itself is game-agnostic; everything that names "bomber" is here.
# Local development only: the loopback ws:// allocation below is accepted only under the
# release compose's `test` registration profile.
#
# Trusted static allocation for slug `bomber`. The launcher points bots at the DS it started
# (DS_READY endpoint) and copies these six claims into that DS's run config from the launch
# response, so WsUrl here is informational. NotAfter is 2100-01-01.
Platform__Allocations__bomber__AllocationId=alloc-bomber-1
Platform__Allocations__bomber__WsUrl=ws://127.0.0.1:9110/bomber
Platform__Allocations__bomber__Subprotocol=lumio.successor-binding-receipts-parts.v1
Platform__Allocations__bomber__ServerAudience=game-fleet-local
Platform__Allocations__bomber__GameId=bomber
Platform__Allocations__bomber__GameReleaseId=bomber-0.0.5-bomber.schema15
Platform__Allocations__bomber__ContractId=lumio.gameplay-envelope.v1
Platform__Allocations__bomber__RoomId=room-bomber-1
Platform__Allocations__bomber__NotAfter=4102444800
Platform__Allocations__bomber__LocalTest=true
