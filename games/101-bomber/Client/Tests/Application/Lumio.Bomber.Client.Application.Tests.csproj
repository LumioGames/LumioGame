<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <LumioEcsGenerate>false</LumioEcsGenerate>
    <BomberClientHostDirectory>$(MSBuildThisFileDirectory)../../../Engine/bot/$(NETCoreSdkRuntimeIdentifier)</BomberClientHostDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pin the direct runtime identity too: transitive project discovery otherwise asks
         Gameplay for its default server output while Application compiled against client. -->
    <ProjectReference Include="../../../Gameplay/Lumio.Bomber.Gameplay.csproj" AdditionalProperties="LumioEcsSide=client" />
    <ProjectReference Include="../../Application/Lumio.Bomber.Client.Application.csproj" />
    <ProjectReference Include="../../Bots/Lumio.Bomber.Bots.csproj" />
    <Reference Include="$(BomberClientHostDirectory)/Lumio.Client.*.dll" Private="true" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Platform" />
  </ItemGroup>
</Project>
