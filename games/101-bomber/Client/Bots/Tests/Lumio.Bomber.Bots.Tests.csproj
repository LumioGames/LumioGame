<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <LumioEcsGenerate>false</LumioEcsGenerate>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Decision/*.cs" Link="Decision/%(Filename)%(Extension)" />
    <None Include="../../Config/Tables/client/bot_profiles.json" Link="Config/bot_profiles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Config/Tables/client/bot_tactics.json" Link="Config/bot_tactics.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Platform" />
  </ItemGroup>
</Project>
